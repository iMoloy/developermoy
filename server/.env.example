# ── Server Environment Variables Template ──────────────────────

# ── Server Configuration ──
NODE_ENV=production
PORT=5000

# ── Database ──
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/developermoy

# ── CORS Allowed Origins (Vercel Production & Localhost) ──
CLIENT_URL=https://developermoy.vercel.app,http://localhost:3000

# ── Authentication Secret & Live Backend URL ──
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=https://developermoy-api.onrender.com
