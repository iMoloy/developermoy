# ── Server Environment Variables Template ──────────────────────

# ── Server Configuration ──
NODE_ENV=production
PORT=5000

# ── Database ──
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/developermoy?retryWrites=true&w=majority

# ── CORS Allowed Origins ──
CLIENT_URL=https://developermoy.vercel.app,http://localhost:3000

# ── Authentication Secret & Live Backend URL ──
# Secret generated with: openssl rand -hex 32 / crypto.randomBytes(32)
BETTER_AUTH_SECRET=your_super_secret_auth_key_here
BETTER_AUTH_URL=https://developermoy-api.onrender.com
